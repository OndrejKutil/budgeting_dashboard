# Copy to ~/budget/.env on the Pi (`bd env` opens it) and fill in. Never commit real values.
# Format: KEY=value, one per line, no quotes, no spaces around =.

# fx (refresh_exchange_rates.py)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# trading, recurring (sync_trading212.py, post_recurring.py)
BACKEND_URL=https://your-backend.onrender.com
BACKEND_API_KEY=your-app-api-key
JOB_SECRET=your-t212-sync-job-secret
