# Backend environment variables — copy to `.env` and fill in real values.
# Loaded by helper/environment.py via python-dotenv. Never commit the real `.env`.

# --- Supabase (Dashboard → Project Settings → API / Database) ---
PROJECT_URL=https://your-project-ref.supabase.co   # Supabase project URL
ANON_KEY=your-anon-public-key                      # Anon/public key — used for user-scoped queries (RLS enforced)
SERVICE_ROLE_KEY=your-service-role-key             # Service role key — account deletion ONLY (bypasses RLS, keep secret)
SUPABASE_JWT_SECRET=your-jwt-secret                # Secret used to verify user access tokens (JWTs)

# --- App auth keys (generate strong random strings) ---
API_KEY=your-app-api-key                           # App-level key required on every request (X-API-KEY header)
ADMIN_KEY=your-admin-key                           # Extra key for admin-only endpoints (e.g. log access)

# --- CORS ---
FRONTEND_URL=http://localhost:5173                 # Allowed frontend origin(s); comma-separated for multiple

# --- Inference (screenshot import) ---
# /screenshot-import runs two calls on the same Groq key: a vision call (INFERENCE_MODEL) that
# reads the screenshot, then a text-only reasoning call (REASONING_MODEL) that matches what it
# read against the user's own categories/accounts. Both are env-configurable, and both must name
# a model the key's provider still serves -- Groq retires ids without warning, and a retired one
# comes back as a 404 `model_not_found` that /extract surfaces as a 502. The values below are
# what the deployment runs as of 2026-09-19; check the provider's model list before trusting them.
# INFERENCE_MODEL must be vision-capable. REASONING_MODEL need not be, but is given no
# reasoning_effort override (see helper/llm_client.py), so it thinks at the provider default and
# that thinking is billed from the same STAGE_TWO_MAX_TOKENS budget as its answer.
INFERENCE_API_KEY=your-provider-api-key            # API key for both /screenshot-import calls
INFERENCE_MODEL=qwen/qwen3.8-27b                   # Vision model: reads the screenshot (stage one)
REASONING_MODEL=openai/gpt-oss-120b                # Text-only model: matches against the user's data (stage two)

# --- Trading212 integration ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
T212_ENCRYPTION_KEY=your-fernet-key                # Encrypts stored T212 API key+secret at rest. Rotating it invalidates every stored connection.
T212_SYNC_JOB_SECRET=your-sync-job-secret          # Authenticates the Pi cron job against POST /trading212/sync-all (X-Job-Secret header)

# --- Misc ---
DEVELOPMENT_MODE=False                             # Set True for verbose/dev-specific behavior

# --- Optional: only needed to run tests/manual.py (manual login test) ---
# EMAIL=you@example.com
# PASSWORD=your-test-account-password
